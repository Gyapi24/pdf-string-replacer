{
  "name": "pdf-string-replace",
  "version": "1.0.0",
  "private": true,
  "description": "Parse a PDF and replace one string with another.",
  "type": "module",
  "imports": {
    "#tspdf/pageEditor.js": "./vendor/pageEditor.mjs",
    "#tspdf/scanner.js": "./vendor/scanner.mjs",
    "#tspdf/splicer.js": "./vendor/splicer.mjs"
  },
  "main": "dist/cli.js",
  "scripts": {
    "start": "npm run build && node dist/cli.js",
    "build": "tsc",
    "sample": "npm run build && node dist/make-sample.js",
