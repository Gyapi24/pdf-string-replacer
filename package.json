    "pdfjs-dist": "^4.10.38",
    "ts-pdf-edit": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/pako": "^2.0.4",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
